---
/**
 * A before/after figure set as a table: label, a hairline track with a bar, the number in mono.
 * The bar is decoration (aria-hidden); the numbers are the data. Grid lines every quarter of `max`.
 */
interface Row { label: string; value: number; kind: "before" | "after" }
interface Props { caption: string; unit: string; max: number; rows: Row[]; note?: string; decimal?: "," | "." }
const { caption, unit, max, rows, note, decimal = "." } = Astro.props;
const fmt = (v: number) => String(v).replace(".", decimal);
const ticks = [0, max / 4, max / 2, (3 * max) / 4, max];
---
<figure class="fig">
  <table class="bars">
    <caption>{caption}</caption>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          <td><span class="track" aria-hidden="true"><span class={`bar ${r.kind}`} style={`width:${(100 * r.value) / max}%`}></span></span></td>
          <td class="n">{fmt(r.value)}&#8239;{unit}</td>
        </tr>
      ))}
      <tr aria-hidden="true">
        <th></th>
        <td><span class="scale">{ticks.map((t) => <span>{fmt(t)}</span>)}</span></td>
        <td class="n label">{unit}</td>
      </tr>
    </tbody>
  </table>
  {note && <figcaption class="caption" set:html={note} />}
</figure>
