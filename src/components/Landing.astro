---
import Base from "../layouts/Base.astro";
import Sec from "./Sec.astro";
import Bars from "./Bars.astro";
import { en, pt } from "../i18n/landing";
import { RELEASES_URL, measured } from "../data/facts";

interface Props { lang: "en" | "pt-BR" }
const { lang } = Astro.props;
const t = lang === "pt-BR" ? pt : en;
const isPt = lang === "pt-BR";
const guide = isPt ? "/pt-br/guia/" : "/guide/";
const L = t.labels;
const strip = (h: string) => h.replace(/<[^>]+>/g, "").replace(/&[a-z]+;/g, " ");
const jsonLd = [
  { "@type": "SoftwareApplication", name: "V3X", alternateName: "V3X script extender for Victoria 3",
    applicationCategory: "GameApplication", applicationSubCategory: "Game modification (script extender)",
    operatingSystem: "Windows (x64)", inLanguage: lang, description: t.description,
    url: new URL(isPt ? "/pt-br/" : "/", Astro.site).href, downloadUrl: RELEASES_URL, softwareRequirements: "Victoria 3 1.15.1",
    codeRepository: "https://github.com/kleeedolinux/v3x",
    featureList: t.register.map((r) => r.head) },
  { "@type": "FAQPage", inLanguage: lang, mainEntity: t.qa.map((q) => ({ "@type": "Question", name: q.q, acceptedAnswer: { "@type": "Answer", text: strip(q.a) } })) },
];
---
<Base title={t.title} description={t.description} lang={lang} section="home" alternate={isPt ? "/" : "/pt-br/"} sheet={isPt ? "01 · Início" : "01 · Front page"} jsonLd={jsonLd}>
  <div class="front">
    <div>
      <p class="kicker">{t.kicker}</p>
      <h1 set:html={t.h1} />
      <p class="lede" set:html={t.lede} />
      <div class="actions">
        <a class="btn primary" href={RELEASES_URL}>{t.download} <small>{t.downloadSub}</small></a>
        <a class="btn" href={guide}>{t.guide} →</a>
      </div>
      <p class="small">{t.promise}</p>
    </div>
    <div>
      <table class="ledger">
        <caption class="kicker">{t.ledgerCaption}</caption>
        <thead><tr><th scope="col"><span class="vh">{isPt ? "Medida" : "Measure"}</span></th><th scope="col" class="n">{t.ledgerHead[1]}</th><th scope="col" class="n">{t.ledgerHead[2]}</th></tr></thead>
        <tbody>
          {t.ledgerRows.map((r) => (
            <tr>
              <th scope="row">{r.what}<span class="tag">{r.tag}</span></th>
              <td class="n before">{r.before}</td>
              <td class="n after">{r.after}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="caption" style="margin-top:var(--s2)">{t.ledgerNote}</p>
    </div>
  </div>

  <Sec n={1} label={L[0]} id="what" title={t.s1}>
    <dl class="register">
      {t.register.map((r) => (
        <div>
          <dt><span>{r.head}</span><span class={`stamp ${r.on ? "on" : "opt"}`}>{r.on ? t.stampOn : t.stampOpt}</span></dt>
          <dd set:html={r.body} />
        </div>
      ))}
    </dl>
  </Sec>

  <Sec n={2} label={L[1]} id="measured" title={t.s2}>
    <p class="measure" set:html={t.s2intro} />
    <div class="plates">
      <Bars caption={t.fig1} unit="s" max={40} decimal={t.decimal} rows={[
        { label: t.figBefore, value: measured.meshLoad.before, kind: "before" },
        { label: t.figAfter, value: measured.meshLoad.after, kind: "after" },
      ]} />
      <Bars caption={t.fig2} unit="MB" max={160} decimal={t.decimal} rows={[
        { label: t.figBefore, value: measured.debugSave.before, kind: "before" },
        { label: t.figAfter, value: measured.debugSave.after, kind: "after" },
      ]} />
    </div>
    <p class="caption measure" style="margin-top:var(--s2)" set:html={t.figNote} />
    <p class="note plain small" set:html={t.method} />
  </Sec>

  <Sec n={3} label={L[2]} id="mods" title={t.s3}>
    <p class="measure" set:html={t.s3intro} />
    <table class="ledger" style="max-width:48rem">
      <thead><tr>{t.cmpHead.map((h, i) => <th scope="col">{i === 0 ? <span class="vh">{isPt ? "Aspecto" : "Aspect"}</span> : h}</th>)}</tr></thead>
      <tbody>{t.cmp.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
    </table>
    <figure class="plate">
      <img src="/assets/how-it-works.svg" width="1200" height="330" loading="lazy" alt={isPt ? "Diagrama: você abre Victoria 3, o V3X carrega junto como um arquivo a mais (version.dll), os plugins corrigem o motor, você joga. Apague version.dll para voltar ao jogo original." : "Diagram: you start Victoria 3, V3X loads with it as one extra file (version.dll), plugins fix the engine, you play. Delete version.dll to return to vanilla."} />
      <figcaption><b>{isPt ? "Prancha I" : "Plate I"}</b>{t.plate1}</figcaption>
    </figure>
  </Sec>

  <Sec n={4} label={L[3]} id="install" title={t.s4}>
    <ol class="steps">
      {t.steps.map((s) => <li><b>{s.b}</b><span set:html={s.t} /></li>)}
    </ol>
    <div class="actions">
      <a class="btn primary" href={RELEASES_URL}>{t.download} <small>{t.downloadSub}</small></a>
      <a class="btn" href={guide}>{t.guide} →</a>
    </div>
    <p class="note small" set:html={t.preNote} />
  </Sec>

  <Sec n={5} label={L[4]} id="off" title={t.s5}>
    <table class="ledger" style="max-width:52rem">
      <thead><tr><th scope="col">{t.offHead[0]}</th><th scope="col">{t.offHead[1]}</th></tr></thead>
      <tbody>{t.off.map((r) => <tr><th scope="row">{r[0]}</th><td set:html={r[1]} /></tr>)}</tbody>
    </table>
  </Sec>

  <Sec n={6} label={L[5]} id="faq" title={t.s6}>
    <div class="qa">
      {t.qa.map((q) => <div><h3>{q.q}</h3><p set:html={q.a} /></div>)}
    </div>
  </Sec>

  <Sec n={7} label={L[6]} id="modders" title={t.s7}>
    <p class="measure" set:html={t.modders} />
    <p><a class="btn" href="/docs/">{t.modLink} →</a></p>
    <figure class="plate">
      <img src="/assets/platform.svg" width="1200" height="560" loading="lazy" alt={isPt ? "A plataforma V3X: plugins usam o SDK e a API; o carregador version.dll os carrega no motor de Victoria 3, que continua intacto no disco." : "The V3X platform: plugins use the SDK and the V3X API; the loader version.dll loads them into the Victoria 3 engine, which stays unchanged on disk."} />
      <figcaption><b>{isPt ? "Prancha II" : "Plate II"}</b>{t.plate2}</figcaption>
    </figure>
  </Sec>
</Base>
