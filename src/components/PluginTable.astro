---
import { shipped } from "../data/facts";
interface Props { lang: "en" | "pt-BR" }
const pt = Astro.props.lang === "pt-BR";
const rows = [...shipped].sort((a, b) => Number(b.on) - Number(a.on));
---
<div class="not-prose my-8 overflow-x-auto rounded-2xl border border-white/[0.08] bg-white/[0.02]">
  <table class="tbl rich">
    <caption class="sr-only">{pt ? "O que o instalador deixa ligado e desligado" : "What setup turns on and leaves off"}</caption>
    <thead><tr><th scope="col">{pt ? "Parte" : "Part"}</th><th scope="col">{pt ? "O que faz por você" : "What it does for you"}</th><th scope="col">{pt ? "Depois de instalar" : "After install"}</th></tr></thead>
    <tbody>
      {rows.map((p) => (
        <tr>
          <th scope="row"><code class="!bg-transparent !px-0 font-mono text-[13px] !text-brass-200">{p.id}</code></th>
          <td class="text-ink-200" set:html={pt ? p.what.pt : p.what.en} />
          <td><span class={p.on ? "pill-on" : "pill-opt"}>{p.on ? (pt ? "ligado" : "on") : (pt ? "desligado" : "off")}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="text-sm text-ink-400">{pt ? "Fonte: " : "Source: "}<a href="/docs/install/">docs/install.md</a>{pt ? " e o " : " and the "}<a href="/docs/plugins/">{pt ? "catálogo de plugins (em inglês)" : "plugin catalog"}</a>.</p>
