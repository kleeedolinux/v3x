---
/** A section with its numeral in the left margin: "§ 1" over a brass hairline. */
interface Props { n: string | number; label?: string; id: string; title: string }
const { n, label, id, title } = Astro.props;
---
<section class="sec" id={id} aria-labelledby={`${id}-h`}>
  <div class="num" aria-hidden="true">§&nbsp;{n}{label && <small>{label}</small>}</div>
  <div>
    <h2 class="head" id={`${id}-h`}>{title}</h2>
    <slot />
  </div>
</section>
