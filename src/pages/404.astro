---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist on the V3X site." sheet="404" noindex>
  <header class="title" style="margin-top:var(--s8)">
    <p class="kicker">Error 404 · Erro 404</p>
    <h1>This page is not in the ledger.</h1>
    <p class="lede" style="margin:0">It may have moved when the docs were re-synced. <span lang="pt-BR">Esta página não existe.</span></p>
  </header>
  <ul class="measure">
    <li><a href="/">Front page</a> · <a href="/pt-br/" lang="pt-BR">Página inicial</a></li>
    <li><a href="/guide/">Players' guide</a> · <a href="/pt-br/guia/" lang="pt-BR">Guia do jogador</a></li>
    <li><a href="/docs/">Documentation</a></li>
  </ul>
</Base>
