---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import DocsNav from "../../components/DocsNav.astro";
import DocsShell from "../../components/DocsShell.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
  return docs.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: docs[i - 1], next: docs[i + 1] } }));
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
// titles may hold `code`: escape, then set code spans
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const titleHtml = esc(entry.data.title).replace(/`([^`]+)`/g, "<code>$1</code>");
const plainTitle = entry.data.title.replace(/`/g, "");
const short = (t: string) => t.replace(/\s*\(.*\)\s*$/, "").replace(/`/g, "");
const groupLabel = { players: "For players", modders: "For modders", engine: "Engine notes" }[entry.data.group];
---
<Base title={`${plainTitle} (docs)`} description={`${entry.data.summary || plainTitle} V3X, the Victoria 3 eXtender: ${groupLabel.toLowerCase()} documentation.`} section="docs" ogType="article"
  ogImage="/og/docs.png"
  crumbs={[{ name: "V3X", href: "/" }, { name: "Docs", href: "/docs/" }, { name: plainTitle, href: `/docs/${entry.id}/` }]}
  jsonLd={[{ "@type": "TechArticle", headline: plainTitle, description: entry.data.summary, inLanguage: "en", dateModified: entry.data.updated, about: "Victoria 3 modding", isBasedOn: entry.data.sourceUrl, proficiencyLevel: entry.data.group === "players" ? "Beginner" : "Expert" }]}>
  <DocsShell toc={headings}>
    <DocsNav slot="nav" current={entry.id} />
    <article>
      <header class="border-b border-white/[0.08] pb-8">
        <p class="flex items-center gap-2 font-mono text-[12px] tracking-[0.12em] text-brass-300 uppercase"><a href="/docs/" class="hover:text-brass-200">Docs</a><span class="text-ink-500">/</span>{groupLabel}</p>
        <h1 class="mt-4 text-[clamp(2rem,1.5rem+2vw,2.875rem)] leading-[1.1] font-bold tracking-[-0.025em] text-white [&_code]:rounded-lg [&_code]:bg-white/[0.07] [&_code]:px-2 [&_code]:font-mono [&_code]:text-[0.85em] [&_code]:text-brass-100" set:html={titleHtml} />
        {entry.data.summary && <p class="mt-4 max-w-2xl text-lg text-ink-200">{entry.data.summary}</p>}
        <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-ink-400">
          <a href={entry.data.sourceUrl} class="inline-flex items-center gap-1.5 hover:text-brass-200"><Icon name="github" class="size-3.5" /><code class="font-mono">{entry.data.source}</code></a>
          <span>Updated <time datetime={entry.data.updated}>{entry.data.updated}</time></span>
        </p>
      </header>
      <div class="prose-v3x mt-10 max-w-[76ch]"><Content /></div>

      <nav class="mt-16 grid gap-4 border-t border-white/[0.08] pt-8 sm:grid-cols-2" aria-label="Previous and next">
        {prev ? <a href={`/docs/${prev.id}/`} class="card card-hover p-5"><span class="text-xs text-ink-400">Previous</span><span class="mt-1 block font-semibold text-white">{short(prev.data.title)}</span></a> : <span></span>}
        {next && <a href={`/docs/${next.id}/`} class="card card-hover p-5 text-right"><span class="text-xs text-ink-400">Next</span><span class="mt-1 block font-semibold text-white">{short(next.data.title)}</span></a>}
      </nav>
    </article>
  </DocsShell>
</Base>
