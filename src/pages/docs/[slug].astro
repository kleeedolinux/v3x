---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import DocsNav from "../../components/DocsNav.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const h2 = headings.filter((h) => h.depth === 2);
// titles may hold `code`: escape, then set code spans
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const titleHtml = esc(entry.data.title).replace(/`([^`]+)`/g, "<code>$1</code>");
const plainTitle = entry.data.title.replace(/`/g, "");
const groupLabel = { players: "For players", modders: "For modders", engine: "Engine notes" }[entry.data.group];
---
<Base title={`${plainTitle}: V3X docs`} description={`${entry.data.summary || plainTitle} V3X, the Victoria 3 script extender: ${groupLabel.toLowerCase()} documentation.`} section="docs" ogType="article"
  ogImage="/og/docs.png"
  crumbs={[{ name: "V3X", href: "/" }, { name: "Docs", href: "/docs/" }, { name: plainTitle, href: `/docs/${entry.id}/` }]}
  jsonLd={[{ "@type": "TechArticle", headline: plainTitle, description: entry.data.summary, inLanguage: "en", dateModified: entry.data.updated, about: "Victoria 3 modding", isBasedOn: entry.data.sourceUrl, proficiencyLevel: entry.data.group === "players" ? "Beginner" : "Expert" }]}
  sheet={`Docs · ${entry.id}`} source={entry.data.source} sourceUrl={entry.data.sourceUrl} revised={entry.data.updated}>
  <div class="page">
    <aside><DocsNav current={entry.id} /></aside>
    <article>
      <header class="title">
        <p class="kicker">Docs · {groupLabel}</p>
        <h1 set:html={titleHtml} />
        {entry.data.summary && <p class="lede" style="margin:0">{entry.data.summary}</p>}
        <p class="caption" style="margin:var(--s2) 0 0">Copied from <a href={entry.data.sourceUrl}><code>{entry.data.source}</code></a> in the V3X repository, file dated <span class="mono">{entry.data.updated}</span>.</p>
      </header>
      {h2.length > 2 && (
        <nav class="contents" aria-label="On this page">
          <p class="label" style="margin:0 0 var(--s1)">On this page</p>
          <ol>{h2.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose"><Content /></div>
    </article>
  </div>
</Base>
