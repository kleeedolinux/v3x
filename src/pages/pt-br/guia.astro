keep_history=1
loc_fallback=1`;
---
<Base lang="pt-BR" title="Como instalar o V3X no Victoria 3: guia do jogador" ogType="article" crumbs={[{ name: "V3X", href: "/pt-br/" }, { name: "Guia do jogador", href: "/pt-br/guia/" }]} jsonLd={[{ "@type": "TechArticle", headline: "Como instalar e usar o V3X", inLanguage: "pt-BR", about: "Victoria 3", proficiencyLevel: "Beginner" }]} description="Como instalar o V3X no Victoria 3, usar o botão V3X do menu principal, ligar e desligar partes, manter as conquistas, desinstalar e o que fazer quando algo dá errado." section="guide" alternate="/guide/">
  <DocsShell toc={toc.map(([slug, text]) => ({ depth: 2, slug, text }))} tocLabel="Nesta página" menuLabel="Menu do guia">
    <Fragment slot="nav">
